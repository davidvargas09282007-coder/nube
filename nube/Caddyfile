# ============================================================================
# Caddy: TLS automatico + proxy WebSocket hacia el contenedor Jarvis.
# Dominio: variable JARVIS_DOMAIN (por defecto localhost, con CA interna).
# Caddy reenvia Upgrade/Connection y no corta conexiones WebSocket largas.
# ============================================================================
{$JARVIS_DOMAIN:localhost} {
	encode zstd gzip
	reverse_proxy jarvis:8080

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output stdout
		format console
	}
}
